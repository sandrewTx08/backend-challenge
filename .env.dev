# Local development environment
NODE_ENV=development
PORT=3000
API_REPLICAS=3
PROXY_PORT=3000
LOG_LEVEL=info
 
# PostgreSQL (local)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=wagering

# LocalStack / AWS SQS (local)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT=http://localhost:4566
SQS_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo
SQS_DLQ_URL=http://localhost:4566/000000000000/wager-transactions-dlq.fifo
SQS_CONSUMER_NAME=wager-transaction-consumer
EVENTS_QUEUE_URL=http://localhost:4566/000000000000/wager-events.fifo

# Tuning
OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_MAX_ATTEMPTS=10

# Keycloak (local)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=wagering
KEYCLOAK_CLIENT_ID=wagering-api
KEYCLOAK_CLIENT_SECRET=wagering-api-secret
KEYCLOAK_TEST_USERNAME=testuser
KEYCLOAK_TEST_PASSWORD=testpass
KEYCLOAK_ISSUER=http://localhost:8080/realms/wagering
KEYCLOAK_JWKS_URI=http://localhost:8080/realms/wagering/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=wagering-api
KEYCLOAK_COMMAND=start-dev --import-realm
