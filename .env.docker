# Docker Compose deployment environment
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# PostgreSQL (container network)
PGHOST=postgres
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=wagering

# LocalStack / AWS SQS (container network)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT=http://localstack:4566
SQS_QUEUE_URL=http://localstack:4566/000000000000/wager-transactions.fifo
SQS_DLQ_URL=http://localstack:4566/000000000000/wager-transactions-dlq.fifo
SQS_CONSUMER_NAME=wager-transaction-consumer
EVENTS_QUEUE_URL=http://localstack:4566/000000000000/wager-events.fifo

# Tuning
OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_MAX_ATTEMPTS=10

# Keycloak (container network)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=wagering
KEYCLOAK_CLIENT_ID=wagering-api
KEYCLOAK_CLIENT_SECRET=wagering-api-secret
KEYCLOAK_TEST_USERNAME=testuser
KEYCLOAK_TEST_PASSWORD=testpass
KEYCLOAK_ISSUER=http://keycloak:8080/realms/wagering
KEYCLOAK_JWKS_URI=http://keycloak:8080/realms/wagering/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=wagering-api
