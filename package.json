{
  "name": "backend-challenge",
  "version": "1.0.0",
  "private": true,
  "description": "Distributed Wagering Processor — Jungle Gaming technical challenge",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "start": "bun run src/main.ts",
    "start:dev": "bun --watch run src/main.ts",
    "start:prod": "bun run src/main.ts",
    "migration:create": "bunx mikro-orm migration:create",
    "migration:up": "bunx mikro-orm migration:up",
    "migration:down": "bunx mikro-orm migration:down",
    "test": "bun test",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test test/integration",
    "test:concurrency": "bun test test/concurrency",
    "test:load": "bun run test/load.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "docker:dev": "docker compose --env-file ./.env.dev up -d --build postgres localstack keycloak",
    "docker:prod": "docker compose --env-file ./.env.prod up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "lint": "bunx eslint 'src/**/*.ts' 'test/**/*.ts' 2>/dev/null || true"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.575.0",
    "@mikro-orm/cli": "^6.3.4",
    "@mikro-orm/core": "^6.3.4",
    "@mikro-orm/migrations": "6.6.17",
    "@mikro-orm/postgresql": "^6.3.4",
    "@nestjs/common": "^10.4.1",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.1",
    "@nestjs/platform-express": "^10.4.1",
    "@nestjs/testing": "^10.4.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.5",
    "jose": "^5.9.0",
    "pg": "^8.13.0",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.1",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^7.2.1",
    "bun-types": "^1.4.4",
    "supertest": "^7.3.1",
    "typescript": "~5.6.3"
  }
}
